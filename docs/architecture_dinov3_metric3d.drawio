        <!-- Calibration note -->
        <mxCell id="L_n_calib" value="&lt;b&gt;μ / σ の決め方&lt;/b&gt;（現在は決め打ち。将来は学習で決める予定）&lt;br&gt;train split の LiDAR (80 samples, 148万点) で較正: scripts/calib_metric3d_sigma.py&lt;br&gt;s = median(gt / pred) = 0.958 &amp;nbsp;/ &amp;nbsp;σ: robust std が深度にほぼ比例 (1–5 m: 0.44 m, 20–25 m: 3.3 m) → 0.18·d&lt;br&gt;LiDAR に対する BCE: hard histogram 17.0 → gauss 10.6" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="770" y="780" width="560" height="80" as="geometry" />
        </mxCell>

        <!-- Weight sources -->
        <mxCell id="L_w_dino" value="&lt;b&gt;📦 DINOv3 weights&lt;/b&gt; (Meta, LVD-1689M)&lt;br&gt;&lt;u&gt;Load&lt;/u&gt;: timm.create_model(&lt;br&gt;&amp;nbsp;'vit_base_patch16_dinov3.lvd1689m',&lt;br&gt;&amp;nbsp;pretrained=True)&lt;br&gt;&lt;u&gt;Source&lt;/u&gt;: HuggingFace Hub&lt;br&gt;&amp;nbsp;timm/vit_base_patch16_dinov3.lvd1689m&lt;br&gt;&amp;nbsp;commit c6a5fb7d / model.safetensors&lt;br&gt;&lt;u&gt;SHA256&lt;/u&gt; 1f9ed8a2…26332 ✅ 公式と一致&lt;br&gt;strict load ✅ / frozen ✅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="10" y="-150" width="230" height="160" as="geometry" />
        </mxCell>
        <mxCell id="L_w_m3d" value="&lt;b&gt;📦 Metric3Dv2 weights&lt;/b&gt; (ViT-Small, 800k iter)&lt;br&gt;&lt;u&gt;Code&lt;/u&gt;: /opt/Metric3D @eb5b6fa (pinned)&lt;br&gt;&lt;u&gt;Weights&lt;/u&gt;: HuggingFace JUGGHM/Metric3D&lt;br&gt;&amp;nbsp;metric_depth_vit_small_800k.pth&lt;br&gt;&lt;u&gt;SHA256&lt;/u&gt; b34b2a2b…728f6 ✅ 公式と一致&lt;br&gt;361/362 loaded (mask_token のみ未使用) ✅&lt;br&gt;frozen ✅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;arcSize=4;" vertex="1" parent="1">
