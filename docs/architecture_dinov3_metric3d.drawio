<mxfile host="app.diagrams.net">
  <diagram id="arch" name="BEVDepth+DINOv3+Metric3Dv2">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;BEVDepth + DINOv3 (frozen) + Metric3Dv2 (frozen)&lt;/b&gt; &amp;nbsp;— camera-layout research baseline&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;bevdepth/exps/nuscenes/mv/bev_depth_dinov3_metric3d.py &amp;nbsp;/&amp;nbsp; backbone: DINOv3Metric3DLSSFPN&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="20" y="-240" width="1200" height="60" as="geometry" />
        </mxCell>

        <!-- Inputs -->
        <mxCell id="img" value="&lt;b&gt;Multi-view images&lt;/b&gt;&lt;br&gt;6 cams × 3×256×704&lt;br&gt;RGB, ImageNet mean/std&lt;br&gt;(ida aug: resize / crop / flip / rot)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="250" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cam" value="&lt;b&gt;Camera params&lt;/b&gt;&lt;br&gt;intrin / sensor2ego&lt;br&gt;ida / bda mats" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="600" width="170" height="70" as="geometry" />
        </mxCell>

        <!-- Image branch -->
        <mxCell id="dino" value="&lt;b&gt;DINOv3 ViT-B/16&lt;/b&gt;&lt;br&gt;vit_base_patch16_dinov3.lvd1689m&lt;br&gt;last block + final LayerNorm&lt;br&gt;❄ Frozen (no_grad, eval)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="250" y="130" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="adapter" value="&lt;b&gt;Adapter&lt;/b&gt;&lt;br&gt;Conv1×1 768→512 + GN + ReLU&lt;br&gt;Conv3×3 512→512&lt;br&gt;🔥 Trainable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="510" y="130" width="200" height="100" as="geometry" />
        </mxCell>

        <!-- Depth branch -->
        <mxCell id="m3dpre" value="&lt;b&gt;Preprocess&lt;/b&gt;&lt;br&gt;aspect-keep resize + zero pad&lt;br&gt;→ 616×1064 (official demo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="250" y="380" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="m3d" value="&lt;b&gt;Metric3Dv2 ViT-S&lt;/b&gt;&lt;br&gt;(torch.hub yvanyin/metric3d)&lt;br&gt;canonical depth (f = 1000)&lt;br&gt;❄ Frozen (no_grad, eval)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="250" y="490" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="conv" value="&lt;b&gt;Canonical → Metric&lt;/b&gt;&lt;br&gt;d = d&lt;sub&gt;c&lt;/sub&gt; · f′ / 1000&lt;br&gt;f′ = fx · √|det(ida&lt;sub&gt;2×2&lt;/sub&gt;)| · s&lt;sub&gt;pad&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="510" y="490" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="hist" value="&lt;b&gt;Depth-bin histogram&lt;/b&gt;&lt;br&gt;112 bins (2–58 m, 0.5 m)&lt;br&gt;per 16×16 px cell&lt;br&gt;→ depth prior 112×16×44" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="770" y="490" width="200" height="90" as="geometry" />
        </mxCell>

        <!-- Fusion -->
        <mxCell id="concat" value="&lt;b&gt;concat&lt;/b&gt;&lt;br&gt;512 + 112 = 624&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(mode = concat)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="800" y="140" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="depthnet" value="&lt;b&gt;DepthNet (camera-aware)&lt;/b&gt;&lt;br&gt;reduce_conv 624→512&lt;br&gt;MLP(27 cam params) + SE ×2&lt;br&gt;depth: 3×BasicBlock + ASPP + DCN → 112&lt;br&gt;context: Conv1×1 → 80&lt;br&gt;🔥 Trainable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1020" y="110" width="240" height="140" as="geometry" />
        </mxCell>
        <mxCell id="softmax" value="&lt;b&gt;softmax&lt;/b&gt;&lt;br&gt;depth dist. 112×16×44" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1320" y="110" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="context" value="&lt;b&gt;context&lt;/b&gt;&lt;br&gt;80×16×44" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1320" y="200" width="170" height="50" as="geometry" />
        </mxCell>

        <!-- LSS -->
        <mxCell id="lift" value="&lt;b&gt;Lift&lt;/b&gt;&lt;br&gt;depth ⊗ context&lt;br&gt;→ frustum 112×80×16×44 / cam" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1550" y="140" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="geom" value="&lt;b&gt;Frustum geometry&lt;/b&gt;&lt;br&gt;pixel × depth → ego xyz&lt;br&gt;(sensor2ego, intrin, ida, bda)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1550" y="600" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pool" value="&lt;b&gt;Voxel Pooling (Splat)&lt;/b&gt;&lt;br&gt;BEV feature 80×128×128&lt;br&gt;±51.2 m, 0.8 m/cell" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1550" y="330" width="190" height="80" as="geometry" />
        </mxCell>

        <!-- BEV head -->
        <mxCell id="bevenc" value="&lt;b&gt;BEV Encoder&lt;/b&gt;&lt;br&gt;ResNet-18-style trunk&lt;br&gt;(3 stages, 160/320/640 ch)&lt;br&gt;+ SECONDFPN → 256×128×128&lt;br&gt;🔥 Trainable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1810" y="320" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="head" value="&lt;b&gt;CenterHead&lt;/b&gt; (6 tasks / 10 classes)&lt;br&gt;heatmap / reg / height / dim / rot / vel&lt;br&gt;heatmap bias init = −2.19&lt;br&gt;🔥 Trainable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="2080" y="320" width="230" height="100" as="geometry" />
        </mxCell>

        <!-- Losses / GT -->
        <mxCell id="lidar" value="LiDAR depth GT&lt;br&gt;(train only)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1570" y="0" width="140" height="60" as="geometry" />
