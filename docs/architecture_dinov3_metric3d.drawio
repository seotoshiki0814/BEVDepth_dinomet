          <mxGeometry x="1820" y="146" width="210" height="25" as="geometry" />
        </mxCell>
        <mxCell id="lg5" value="Loss (train only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1820" y="178" width="210" height="25" as="geometry" />
        </mxCell>

        <!-- Params summary -->
        <mxCell id="params" value="&lt;b&gt;Params&lt;/b&gt;: Trainable 53.5M / Frozen 123M&lt;br&gt;RTX 3060, bs=1, AMP fp16: ~0.45 it/s, peak ~2.3 GB (fwd)" style="text;html=1;align=left;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="760" width="600" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="arch_lift" name="mode: lift (no DepthNet)">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="L_title" value="&lt;b&gt;BEVDepth + DINOv3 (frozen) + Metric3Dv2 (frozen) — lift mode (DepthNet なし)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;bev_depth_dinov3_metric3d.py --depth_prior_mode lift &amp;nbsp;[--depth_scale 0.958 --depth_sigma_k 0.18 --depth_sigma_min 0.5]&lt;br&gt;Metric3D のガウス深度分布をそのまま Lift。context = Conv1×1(concat[DINOv3, prior])。depth loss はログのみ&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="20" y="-250" width="1500" height="80" as="geometry" />
        </mxCell>

        <!-- Inputs -->
        <mxCell id="L_img" value="&lt;b&gt;Multi-view images&lt;/b&gt;&lt;br&gt;6 cams × 3×256×704&lt;br&gt;RGB, ImageNet mean/std&lt;br&gt;(ida aug: resize / crop / flip / rot)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="250" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="L_cam" value="&lt;b&gt;Camera params&lt;/b&gt;&lt;br&gt;intrin / sensor2ego&lt;br&gt;ida / bda mats" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="600" width="170" height="70" as="geometry" />
        </mxCell>

        <!-- Image branch -->
        <mxCell id="L_dino" value="&lt;b&gt;DINOv3 ViT-B/16&lt;/b&gt;&lt;br&gt;vit_base_patch16_dinov3.lvd1689m&lt;br&gt;last block + final LayerNorm&lt;br&gt;❄ Frozen (no_grad, eval)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="250" y="130" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="L_adapter" value="&lt;b&gt;Adapter&lt;/b&gt;&lt;br&gt;Conv1×1 768→512 + GN + ReLU&lt;br&gt;Conv3×3 512→512&lt;br&gt;🔥 Trainable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="510" y="130" width="200" height="100" as="geometry" />
        </mxCell>

        <!-- Depth branch -->
        <mxCell id="L_m3dpre" value="&lt;b&gt;Preprocess&lt;/b&gt;&lt;br&gt;aspect-keep resize + zero pad&lt;br&gt;→ 616×1064 (official demo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="250" y="380" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="L_m3d" value="&lt;b&gt;Metric3Dv2 ViT-S&lt;/b&gt;&lt;br&gt;(/opt/Metric3D @eb5b6fa)&lt;br&gt;canonical depth (f = 1000)&lt;br&gt;❄ Frozen (no_grad, eval)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="250" y="490" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="L_conv" value="&lt;b&gt;Canonical → Metric&lt;/b&gt;&lt;br&gt;d = d&lt;sub&gt;c&lt;/sub&gt; · f′ / 1000&lt;br&gt;f′ = fx · √|det(ida&lt;sub&gt;2×2&lt;/sub&gt;)| · s&lt;sub&gt;pad&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="510" y="490" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="L_gauss" value="&lt;b&gt;Gaussian depth prior&lt;/b&gt; (depth_prior_type=gauss)&lt;br&gt;4×4 sub-samples / 16×16 px cell&lt;br&gt;μ = s·d &amp;nbsp;(s = 0.958)&lt;br&gt;σ = max(0.5 m, 0.18·μ)&lt;br&gt;∫ N(μ, σ) over bin edges → 112 bins (2–58 m)&lt;br&gt;mean over 16 samples → prior 112×16×44&lt;br&gt;範囲外 (空・&amp;gt;58 m) の質量は捨てる: Σ&lt;sub&gt;d&lt;/sub&gt; ≤ 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="770" y="460" width="260" height="140" as="geometry" />
        </mxCell>

        <!-- Fusion: context path -->
        <mxCell id="L_concat" value="&lt;b&gt;concat&lt;/b&gt;&lt;br&gt;512 + 112 = 624" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="800" y="140" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="L_ctxconv" value="&lt;b&gt;context_conv&lt;/b&gt;&lt;br&gt;Conv1×1 624→80&lt;br&gt;🔥 Trainable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1030" y="140" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="L_ctxmass" value="&lt;b&gt;context × m&lt;/b&gt;&lt;br&gt;m = Σ&lt;sub&gt;d&lt;/sub&gt; prior (範囲内の質量)&lt;br&gt;→ context 80×16×44&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;空など m≈0 の画素は何も置かない&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1290" y="130" width="190" height="100" as="geometry" />
        </mxCell>

        <!-- Depth path -->
        <mxCell id="L_norm" value="&lt;b&gt;normalize&lt;/b&gt;&lt;br&gt;p = prior / m&lt;br&gt;logits = log p&lt;br&gt;(LSS の softmax で p に戻る)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1290" y="310" width="190" height="90" as="geometry" />
        </mxCell>

        <!-- Removed DepthNet -->
        <mxCell id="L_removed" value="&lt;b&gt;✕ DepthNet は削除&lt;/b&gt; (−28.2M params)&lt;br&gt;camera-aware SE / ASPP / DCN なし&lt;br&gt;→ カメラパラメータが効くのは&lt;br&gt;&amp;nbsp;Metric3D の f′ と Lift/Splat の幾何のみ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;fontColor=#666666;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1000" y="260" width="240" height="80" as="geometry" />
        </mxCell>

        <!-- LSS -->
        <mxCell id="L_lift" value="&lt;b&gt;Lift&lt;/b&gt;&lt;br&gt;p(d) ⊗ (m · context)&lt;br&gt;= prior(d) ⊗ context&lt;br&gt;→ frustum 112×80×16×44 / cam" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1550" y="200" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="L_geom" value="&lt;b&gt;Frustum geometry&lt;/b&gt;&lt;br&gt;pixel × depth → ego xyz&lt;br&gt;(sensor2ego, intrin, ida, bda)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1555" y="600" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="L_pool" value="&lt;b&gt;Voxel Pooling (Splat)&lt;/b&gt;&lt;br&gt;BEV feature 80×128×128&lt;br&gt;±51.2 m, 0.8 m/cell" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1555" y="380" width="190" height="80" as="geometry" />
        </mxCell>

        <!-- BEV head -->
        <mxCell id="L_bevenc" value="&lt;b&gt;BEV Encoder&lt;/b&gt;&lt;br&gt;ResNet-18-style trunk&lt;br&gt;(3 stages, 160/320/640 ch)&lt;br&gt;+ SECONDFPN → 256×128×128&lt;br&gt;🔥 Trainable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1810" y="370" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="L_head" value="&lt;b&gt;CenterHead&lt;/b&gt; (6 tasks / 10 classes)&lt;br&gt;heatmap / reg / height / dim / rot / vel&lt;br&gt;heatmap bias init = −2.19&lt;br&gt;🔥 Trainable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="2080" y="370" width="230" height="100" as="geometry" />
        </mxCell>

        <!-- Losses / GT -->
        <mxCell id="L_dloss" value="&lt;b&gt;depth_loss_monitor&lt;/b&gt;&lt;br&gt;BCE × 3.0 vs LiDAR&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ログのみ (学習に不使用 / no grad)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1290" y="450" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="L_lidar" value="LiDAR depth GT&lt;br&gt;(train only)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1315" y="550" width="140" height="60" as="geometry" />
