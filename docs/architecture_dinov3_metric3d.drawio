        <mxCell id="L_boxgt" value="3D box GT" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="2125" y="650" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="L_detloss" value="&lt;b&gt;Detection loss&lt;/b&gt; (= 学習 loss の全て)&lt;br&gt;GaussianFocal (heatmap)&lt;br&gt;+ L1 × 0.25 (bbox)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="2085" y="520" width="220" height="70" as="geometry" />
