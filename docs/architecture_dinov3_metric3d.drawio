        <!-- Weight sources -->
        <mxCell id="w_dino" value="&lt;b&gt;📦 DINOv3 weights&lt;/b&gt; (Meta, LVD-1689M)&lt;br&gt;&lt;u&gt;Load&lt;/u&gt;: timm.create_model(&lt;br&gt;&amp;nbsp;'vit_base_patch16_dinov3.lvd1689m',&lt;br&gt;&amp;nbsp;pretrained=True)&lt;br&gt;&lt;u&gt;Source&lt;/u&gt;: HuggingFace Hub&lt;br&gt;&amp;nbsp;timm/vit_base_patch16_dinov3.lvd1689m&lt;br&gt;&amp;nbsp;commit c6a5fb7d / model.safetensors&lt;br&gt;&amp;nbsp;342,579,728 B&lt;br&gt;&lt;u&gt;SHA256&lt;/u&gt; 1f9ed8a2…26332 ✅ 公式と一致&lt;br&gt;&lt;u&gt;Cache&lt;/u&gt;: /root/.cache/huggingface/hub/&lt;br&gt;strict load ✅ / frozen ✅ / License: DINOv3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="10" y="-170" width="230" height="190" as="geometry" />
        </mxCell>
        <mxCell id="w_m3d" value="&lt;b&gt;📦 Metric3Dv2 weights&lt;/b&gt; (ViT-Small, 800k iter)&lt;br&gt;&lt;u&gt;Load&lt;/u&gt;: torch.hub.load('yvanyin/metric3d',&lt;br&gt;&amp;nbsp;'metric3d_vit_small', pretrain=True)&lt;br&gt;&lt;u&gt;Code&lt;/u&gt;: GitHub YvanYin/Metric3D @main&lt;br&gt;&amp;nbsp;(⚠ unpinned)&lt;br&gt;&lt;u&gt;Weights&lt;/u&gt;: HuggingFace JUGGHM/Metric3D&lt;br&gt;&amp;nbsp;metric_depth_vit_small_800k.pth&lt;br&gt;&amp;nbsp;150,120,967 B&lt;br&gt;&lt;u&gt;SHA256&lt;/u&gt; b34b2a2b…728f6 ✅ 公式と一致&lt;br&gt;&lt;u&gt;Cache&lt;/u&gt;: /root/.cache/torch/hub/checkpoints/&lt;br&gt;strict=False → 361/362 loaded&lt;br&gt;&amp;nbsp;(未ロードは mask_token のみ・推論未使用) ✅&lt;br&gt;frozen ✅ (3 step 後も全テンソル不変)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="10" y="820" width="250" height="210" as="geometry" />
        </mxCell>
        <mxCell id="w_note" value="⚠ どちらのキャッシュもコンテナ内 (/root/.cache) で D: にマウントされていない → コンテナ再作成で再DL" style="text;html=1;align=left;fontSize=10;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="280" y="990" width="560" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ew1" value="load weights" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#9673a6;fontColor=#9673a6;labelBackgroundColor=#ffffff;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.2;" edge="1" parent="1" source="w_dino" target="dino">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ew2" value="load weights" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#9673a6;fontColor=#9673a6;labelBackgroundColor=#ffffff;fontSize=10;exitX=1;exitY=0.25;entryX=0.5;entryY=1;" edge="1" parent="1" source="w_m3d" target="m3d">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="350" y="872" /></Array>
          </mxGeometry>
        </mxCell>

        <!-- Fix notes -->
        <mxCell id="n1" value="&lt;b&gt;Fix ①&lt;/b&gt; timm features_only が最終 LN を Identity に prune&lt;br&gt;→ forward_intermediates(norm=True)&lt;br&gt;(出力 std 57 → 0.4)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="250" y="60" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;Fix ③&lt;/b&gt; flip で ida[0,0]&amp;lt;0 → fx が負になっていた&lt;br&gt;→ √|det| で resize 倍率を算出 + 公式 pad 前処理&lt;br&gt;(LiDAR 比 AbsRel 0.75 → 0.14)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="770" y="600" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;Fix ②&lt;/b&gt; Lightning は init_weights() を呼ばない&lt;br&gt;→ heatmap bias −2.19 を __init__ で設定&lt;br&gt;(初期 loss_heatmap 17,000 → 440)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2050" y="230" width="290" height="60" as="geometry" />
