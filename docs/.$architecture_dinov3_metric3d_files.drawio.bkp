<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0"><diagram id="p1" name="concat / replace（全体）"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1_1" value='&lt;b style="font-size:16px"&gt;BEVDepth + DINOv3 (frozen) + Metric3Dv2 (frozen) — depth_prior_mode = concat（既定） / replace&lt;/b&gt;&lt;br&gt;実行: python bevdepth/exps/nuscenes/mv/bev_depth_dinov3_metric3d.py --depth_prior_mode concat　｜　model = BaseBEVDepth（models/base_bev_depth.py）: backbone → head' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1640" height="60" as="geometry"/></mxCell><mxCell id="p1_2" value='&lt;b&gt;入力画像 sweep_imgs&lt;/b&gt;&lt;br&gt;(B, 1 sweep, 6 cams, 3, 256, 704)&lt;br&gt;RGB (to_rgb=False), ImageNet mean/std&lt;br&gt;ida aug: resize/crop/flip/rot&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 bevdepth/datasets/nusc_det_dataset.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ NuscDetDataset / collate_fn&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#F5F5F5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="200" height="150" as="geometry"/></mxCell><mxCell id="p1_3" value='&lt;b&gt;mats_dict&lt;/b&gt;&lt;br&gt;intrin_mats / ida_mats&lt;br&gt;sensor2ego_mats / bda_mat&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 bevdepth/datasets/nusc_det_dataset.py&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#F5F5F5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="200" height="120" as="geometry"/></mxCell><mxCell id="p1_4" value='&lt;b&gt;GT（学習時のみ）&lt;/b&gt;&lt;br&gt;gt_boxes, gt_labels&lt;br&gt;depth_labels (LiDAR 投影深度)&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 bevdepth/datasets/nusc_det_dataset.py&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#F5F5F5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="760" width="200" height="130" as="geometry"/></mxCell><mxCell id="p1_5" value='model.backbone = DINOv3Metric3DLSSFPN&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 layers/backbones/dinov3_metric3d_lss_fpn.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ DINOv3Metric3DLSSFPN ← DINOv3LSSFPN ← BaseLSSFPN&lt;/font&gt;' style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="80" width="1060" height="640" as="geometry"/></mxCell><mxCell id="p1_6" value='&lt;b&gt;DINOv3 ViT-B/16&lt;/b&gt; ❄&lt;br&gt;timm vit_base_patch16_dinov3.lvd1689m&lt;br&gt;forward_intermediates(last block, norm=True)&lt;br&gt;→ (B·6, 768, 16, 44)&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 layers/backbones/dinov3_lss_fpn.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ DINOv3LSSFPN.get_cam_feats&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="270" y="120" width="230" height="140" as="geometry"/></mxCell><mxCell id="p1_7" value='&lt;b&gt;Adapter&lt;/b&gt; 🔥&lt;br&gt;Conv1×1 768→512 + GN(32) + ReLU&lt;br&gt;Conv3×3 512→512&lt;br&gt;→ feat (B·6, 512, 16, 44)&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 layers/backbones/dinov3_lss_fpn.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ DINOv3LSSFPN.adapter&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="530" y="120" width="220" height="140" as="geometry"/></mxCell><mxCell id="p1_8" value='&lt;b&gt;Metric3Dv2 ViT-S&lt;/b&gt; ❄&lt;br&gt;torch.hub metric3d_vit_small&lt;br&gt;(METRIC3D_REPO_DIR 優先 / なければ GitHub)&lt;br&gt;aspect-keep resize + zero pad → 616×1064&lt;br&gt;→ canonical depth (f=1000)&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 layers/backbones/dinov3_metric3d_lss_fpn.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ DINOv3Metric3DLSSFPN._run_metric3d&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="270" y="300" width="230" height="160" as="geometry"/></mxCell><mxCell id="p1_9" value='&lt;b&gt;Depth prior 生成&lt;/b&gt;&lt;br&gt;metric = canonical · f′ / 1000&lt;br&gt;f′ = fx · √|det(ida₂ₓ₂)| · s_pad&lt;br&gt;nearest → 64×176 (4×4 sub-sample/セル)&lt;br&gt;hard（既定）: 112 bin の one-hot ヒストグラム&lt;br&gt;gauss: N(s·d, max(σ_min, k·s·d)) を bin 積分&lt;br&gt;avg_pool 4×4 → prior (B·6, 112, 16, 44)&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 layers/backbones/dinov3_metric3d_lss_fpn.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ DINOv3Metric3DLSSFPN._depth_prior&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="530" y="300" width="220" height="190" as="geometry"/></mxCell><mxCell id="p1_10" value='&lt;b&gt;C&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;624ch&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="780" y="205" width="60" height="60" as="geometry"/></mxCell><mxCell id="p1_11" value='&lt;b&gt;DepthNet&lt;/b&gt; 🔥（camera-aware）&lt;br&gt;reduce_conv[0]: 624→512 に差し替え（concat 時）&lt;br&gt;Conv3×3 + BN + ReLU&lt;br&gt;MLP(27-dim cam params) → SE ×2&lt;br&gt;depth: BasicBlock×3 → ASPP → DCN → Conv1×1 → 112&lt;br&gt;context: Conv1×1 → 80&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 layers/backbones/base_lss_fpn.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ DepthNet / ASPP / SELayer / Mlp&lt;/font&gt;&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 layers/backbones/dinov3_metric3d_lss_fpn.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ __init__（Conv 差し替え） / _forward_depth_net&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="780" y="300" width="250" height="260" as="geometry"/></mxCell><mxCell id="p1_12" value='&lt;b&gt;replace モード時&lt;/b&gt;&lt;br&gt;DepthNet 入力は feat (512ch) のみ&lt;br&gt;depth logits = log(prior + ε) で置換&lt;br&gt;（DepthNet の depth 出力は破棄、context のみ使用）&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 layers/backbones/dinov3_metric3d_lss_fpn.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ _forward_depth_net&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="780" y="590" width="250" height="110" as="geometry"/></mxCell><mxCell id="p1_13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_2" target="p1_6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_14" value="key sweep" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.8;exitY=1;" edge="1" parent="1" source="p1_2" target="p1_8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_15" value="768×16×44" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_6" target="p1_7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_8" target="p1_9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_17" value="fx, ida" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.3;entryX=0.3;entryY=1;" edge="1" parent="1" source="p1_3" target="p1_9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_18" value="512" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_7" target="p1_10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_19" value="112" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2;" edge="1" parent="1" source="p1_9" target="p1_10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_10" target="p1_11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_21" value="27-dim cam params" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.6;entryX=0;entryY=0.95;" edge="1" parent="1" source="p1_3" target="p1_11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_22" value="replace" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_9" target="p1_12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_23" value='&lt;b&gt;Lift&lt;/b&gt;&lt;br&gt;softmax(depth logits) ⊗ context&lt;br&gt;→ frustum feat (B·6, 80, 112, 16, 44)&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 layers/backbones/base_lss_fpn.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ BaseLSSFPN._forward_single_sweep&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="1060" y="120" width="230" height="120" as="geometry"/></mxCell><mxCell id="p1_24" value='&lt;b&gt;Frustum geometry&lt;/b&gt;&lt;br&gt;(u, v, d) を ida⁻¹ → intrin⁻¹ →&lt;br&gt;sensor2ego → bda で ego xyz へ&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 layers/backbones/base_lss_fpn.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ create_frustum / get_geometry&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="1060" y="280" width="230" height="120" as="geometry"/></mxCell><mxCell id="p1_25" value='&lt;b&gt;Voxel Pooling (Splat)&lt;/b&gt;&lt;br&gt;train: voxel_pooling_train&lt;br&gt;infer: voxel_pooling_inference&lt;br&gt;→ BEV feat (B, 80, 128, 128)&lt;br&gt;±51.2 m, 0.8 m/セル&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 ops/voxel_pooling_train/, ops/voxel_pooling_inference/&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ CUDA拡張&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="1060" y="440" width="230" height="140" as="geometry"/></mxCell><mxCell id="p1_26" value="depth logits 112" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_11" target="p1_23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_27" value="intrin / ida / sensor2ego / bda" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.8;" edge="1" parent="1" source="p1_3" target="p1_24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="p1_23" target="p1_25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_29" value="voxel index" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_24" target="p1_25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_30" value='model.head = BEVDepthHead&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 layers/heads/bev_depth_head.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ BEVDepthHead&lt;/font&gt;' style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1330" y="80" width="330" height="640" as="geometry"/></mxCell><mxCell id="p1_31" value='&lt;b&gt;BEV trunk: ResNet-18&lt;/b&gt; 🔥 (mmdet)&lt;br&gt;in 80ch, base 160ch, 3 stages, maxpool 削除&lt;br&gt;→ 160@64², 320@32², 640@16²&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 layers/heads/bev_depth_head.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ self.trunk / forward&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1350" y="150" width="290" height="130" as="geometry"/></mxCell><mxCell id="p1_32" value='&lt;b&gt;BEV neck: SECONDFPN&lt;/b&gt; 🔥 (mmdet3d)&lt;br&gt;[80,160,320,640] ↑[1,2,4,8] → 64ch×4&lt;br&gt;→ (B, 256, 128, 128)&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 layers/heads/bev_depth_head.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ self.neck&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1350" y="310" width="290" height="120" as="geometry"/></mxCell><mxCell id="p1_33" value='&lt;b&gt;CenterHead&lt;/b&gt; 🔥 (mmdet3d CenterHead 継承)&lt;br&gt;shared conv + SeparateHead × 6 tasks&lt;br&gt;heatmap / reg(2) / height(1) / dim(3) / rot(2) / vel(2)&lt;br&gt;heatmap bias init −2.19&lt;br&gt;&lt;br&gt;tasks: car | truck, const_veh | bus, trailer |&lt;br&gt;barrier | motorcycle, bicycle | ped, cone&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 layers/heads/bev_depth_head.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ BEVDepthHead.__init__ / forward&lt;/font&gt;&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 exps/nuscenes/base_exp.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ head_conf / TASKS / common_heads&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1350" y="460" width="290" height="240" as="geometry"/></mxCell><mxCell id="p1_34" value="80×128×128" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_25" target="p1_31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_31" target="p1_32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_36" value="256×128×128" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_32" target="p1_33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_37" value='&lt;b&gt;学習 training_step&lt;/b&gt;&lt;br&gt;detection_loss = GaussianFocal(heatmap) + 0.25·L1(bbox)&lt;br&gt;depth_loss = 3.0 · BCE(softmax(depth), LiDAR one-hot)  (fg pixel)&lt;br&gt;&lt;b&gt;loss = detection_loss + depth_loss&lt;/b&gt;&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 exps/nuscenes/base_exp.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ training_step / get_depth_loss / get_downsampled_gt_depth&lt;/font&gt;&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 exps/nuscenes/mv/bev_depth_dinov3.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ training_step (loss 成分のログ)&lt;/font&gt;&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 layers/heads/bev_depth_head.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ get_targets / loss&lt;/font&gt;&lt;br&gt;Optimizer: AdamW(requires_grad のみ) + MultiStepLR (--lr 指定時)&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 exps/nuscenes/mv/bev_depth_dinov3.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ configure_optimizers&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="270" y="760" width="560" height="230" as="geometry"/></mxCell><mxCell id="p1_38" value='&lt;b&gt;推論 eval_step / predict_step&lt;/b&gt;&lt;br&gt;model(imgs, mats) → head.get_bboxes&lt;br&gt;CenterPointBBoxCoder decode → circle NMS&lt;br&gt;→ 3D boxes / scores / labels&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 exps/nuscenes/base_exp.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ eval_step / test_step / predict_step&lt;/font&gt;&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 layers/heads/bev_depth_head.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ get_bboxes / size_aware_circle_nms&lt;/font&gt;&lt;br&gt;評価: nuScenes mAP / NDS、-p 時は結果 JSON 出力&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 evaluators/det_evaluators.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ DetNuscEvaluator&lt;/font&gt;&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 exps/base_cli.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ run_cli: fit / -e test / -p predict&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="860" y="760" width="440" height="230" as="geometry"/></mxCell><mxCell id="p1_39" value="preds (train)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="p1_33" target="p1_37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_40" value="preds (eval)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="p1_33" target="p1_38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_41" value="GT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_4" target="p1_37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_42" value="depth (softmax)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="p1_11" target="p1_37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_43" value="&lt;b&gt;凡例&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1360" y="760" width="300" height="190" as="geometry"/></mxCell><mxCell id="p1_44" value="❄ Frozen（事前学習・勾配なし）" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1370" y="788" width="135" height="30" as="geometry"/></mxCell><mxCell id="p1_45" value="🔥 Trainable" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1515" y="788" width="135" height="30" as="geometry"/></mxCell><mxCell id="p1_46" value="パラメータなし演算" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1370" y="826" width="135" height="30" as="geometry"/></mxCell><mxCell id="p1_47" value="データ / GT" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#F5F5F5;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1515" y="826" width="135" height="30" as="geometry"/></mxCell><mxCell id="p1_48" value="学習（Loss）" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1370" y="864" width="135" height="30" as="geometry"/></mxCell><mxCell id="p1_49" value="推論 / 評価" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1515" y="864" width="135" height="30" as="geometry"/></mxCell><mxCell id="p1_50" value='&lt;font color="#1F4E9E"&gt;📄 青字&lt;/font&gt; = 実装ファイル（↳ クラス/メソッド）&lt;br&gt;パスは bevdepth/ 以下のリポジトリ相対パス' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1370" y="900" width="285" height="45" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="lift（DepthNet なし）"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2_1" value='&lt;b style="font-size:16px"&gt;depth_prior_mode = lift — DepthNet を削除し、Metric3D prior を直接 LSS の深度分布に使用&lt;/b&gt;&lt;br&gt;実行: python bevdepth/exps/nuscenes/mv/bev_depth_dinov3_metric3d.py --depth_prior_mode lift　｜　depth_prior_type 既定 = gauss（s=0.958, k=0.18, σ_min=0.5 m）' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1640" height="60" as="geometry"/></mxCell><mxCell id="p2_2" value='&lt;b&gt;入力画像 sweep_imgs&lt;/b&gt;&lt;br&gt;(B, 1 sweep, 6 cams, 3, 256, 704)&lt;br&gt;RGB (to_rgb=False), ImageNet mean/std&lt;br&gt;ida aug: resize/crop/flip/rot&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 bevdepth/datasets/nusc_det_dataset.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ NuscDetDataset / collate_fn&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#F5F5F5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="200" height="150" as="geometry"/></mxCell><mxCell id="p2_3" value='&lt;b&gt;mats_dict&lt;/b&gt;&lt;br&gt;intrin_mats / ida_mats&lt;br&gt;sensor2ego_mats / bda_mat&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 bevdepth/datasets/nusc_det_dataset.py&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#F5F5F5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="200" height="120" as="geometry"/></mxCell><mxCell id="p2_4" value='&lt;b&gt;GT（学習時のみ）&lt;/b&gt;&lt;br&gt;gt_boxes, gt_labels&lt;br&gt;depth_labels (LiDAR 投影深度)&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 bevdepth/datasets/nusc_det_dataset.py&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#F5F5F5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="760" width="200" height="130" as="geometry"/></mxCell><mxCell id="p2_5" value='model.backbone = DINOv3Metric3DLSSFPN（del self.depth_net）&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 layers/backbones/dinov3_metric3d_lss_fpn.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ DINOv3Metric3DLSSFPN&lt;/font&gt;' style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="80" width="1060" height="640" as="geometry"/></mxCell><mxCell id="p2_6" value='&lt;b&gt;DINOv3 ViT-B/16&lt;/b&gt; ❄&lt;br&gt;timm vit_base_patch16_dinov3.lvd1689m&lt;br&gt;forward_intermediates(last block, norm=True)&lt;br&gt;→ (B·6, 768, 16, 44)&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 layers/backbones/dinov3_lss_fpn.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ DINOv3LSSFPN.get_cam_feats&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="270" y="120" width="230" height="140" as="geometry"/></mxCell><mxCell id="p2_7" value='&lt;b&gt;Adapter&lt;/b&gt; 🔥&lt;br&gt;Conv1×1 768→512 + GN(32) + ReLU&lt;br&gt;Conv3×3 512→512&lt;br&gt;→ feat (B·6, 512, 16, 44)&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 layers/backbones/dinov3_lss_fpn.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ DINOv3LSSFPN.adapter&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="530" y="120" width="220" height="140" as="geometry"/></mxCell><mxCell id="p2_8" value='&lt;b&gt;Metric3Dv2 ViT-S&lt;/b&gt; ❄&lt;br&gt;torch.hub metric3d_vit_small&lt;br&gt;(METRIC3D_REPO_DIR 優先 / なければ GitHub)&lt;br&gt;aspect-keep resize + zero pad → 616×1064&lt;br&gt;→ canonical depth (f=1000)&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 layers/backbones/dinov3_metric3d_lss_fpn.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ DINOv3Metric3DLSSFPN._run_metric3d&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="270" y="300" width="230" height="160" as="geometry"/></mxCell><mxCell id="p2_9" value='&lt;b&gt;Depth prior 生成&lt;/b&gt;&lt;br&gt;metric = canonical · f′ / 1000&lt;br&gt;f′ = fx · √|det(ida₂ₓ₂)| · s_pad&lt;br&gt;nearest → 64×176 (4×4 sub-sample/セル)&lt;br&gt;gauss（既定）: N(s·d, max(σ_min, k·s·d)) を bin 積分&lt;br&gt;hard: one-hot ヒストグラム&lt;br&gt;avg_pool 4×4 → prior (B·6, 112, 16, 44)&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 layers/backbones/dinov3_metric3d_lss_fpn.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ DINOv3Metric3DLSSFPN._depth_prior&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="530" y="300" width="220" height="190" as="geometry"/></mxCell><mxCell id="p2_10" value='&lt;b&gt;C&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;624ch&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="780" y="160" width="60" height="60" as="geometry"/></mxCell><mxCell id="p2_11" value='&lt;b&gt;context_conv&lt;/b&gt; 🔥&lt;br&gt;Conv1×1 624→80&lt;br&gt;× mass（範囲内確率和）&lt;br&gt;→ context 80&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 layers/backbones/dinov3_metric3d_lss_fpn.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ __init__ / _forward_depth_net&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="870" y="120" width="160" height="140" as="geometry"/></mxCell><mxCell id="p2_12" value='&lt;b&gt;prior 正規化&lt;/b&gt;&lt;br&gt;mass = Σ prior&lt;br&gt;p = prior / mass（mass≈0 なら一様）&lt;br&gt;logits = log(p) → softmax で p に戻る&lt;br&gt;（空・58 m 超は mass≈0 → 何も置かない）&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 layers/backbones/dinov3_metric3d_lss_fpn.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ _forward_depth_net&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="800" y="380" width="230" height="150" as="geometry"/></mxCell><mxCell id="p2_13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p2_2" target="p2_6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_14" value="key sweep" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.8;exitY=1;" edge="1" parent="1" source="p2_2" target="p2_8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_15" value="768×16×44" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p2_6" target="p2_7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p2_8" target="p2_9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_17" value="fx, ida" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.3;entryX=0.3;entryY=1;" edge="1" parent="1" source="p2_3" target="p2_9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_18" value="512" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p2_7" target="p2_10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_19" value="112" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.1;" edge="1" parent="1" source="p2_9" target="p2_10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p2_10" target="p2_11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p2_9" target="p2_12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_22" value="mass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="p2_12" target="p2_11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_23" value='&lt;b&gt;Lift&lt;/b&gt;&lt;br&gt;softmax(depth logits) ⊗ context&lt;br&gt;→ frustum feat (B·6, 80, 112, 16, 44)&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 layers/backbones/base_lss_fpn.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ BaseLSSFPN._forward_single_sweep&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="1060" y="120" width="230" height="120" as="geometry"/></mxCell><mxCell id="p2_24" value='&lt;b&gt;Frustum geometry&lt;/b&gt;&lt;br&gt;(u, v, d) を ida⁻¹ → intrin⁻¹ →&lt;br&gt;sensor2ego → bda で ego xyz へ&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 layers/backbones/base_lss_fpn.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ create_frustum / get_geometry&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="1060" y="280" width="230" height="120" as="geometry"/></mxCell><mxCell id="p2_25" value='&lt;b&gt;Voxel Pooling (Splat)&lt;/b&gt;&lt;br&gt;train: voxel_pooling_train&lt;br&gt;infer: voxel_pooling_inference&lt;br&gt;→ BEV feat (B, 80, 128, 128)&lt;br&gt;±51.2 m, 0.8 m/セル&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 ops/voxel_pooling_train/, ops/voxel_pooling_inference/&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ CUDA拡張&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="1060" y="440" width="230" height="140" as="geometry"/></mxCell><mxCell id="p2_26" value="depth logits 112" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p2_12" target="p2_23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_27" value="context 80" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p2_11" target="p2_23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_28" value="intrin / ida / sensor2ego / bda" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.8;" edge="1" parent="1" source="p2_3" target="p2_24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="p2_23" target="p2_25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_30" value="voxel index" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p2_24" target="p2_25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_31" value='model.head = BEVDepthHead&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 layers/heads/bev_depth_head.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ BEVDepthHead&lt;/font&gt;' style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1330" y="80" width="330" height="640" as="geometry"/></mxCell><mxCell id="p2_32" value='&lt;b&gt;BEV trunk: ResNet-18&lt;/b&gt; 🔥 (mmdet)&lt;br&gt;in 80ch, base 160ch, 3 stages, maxpool 削除&lt;br&gt;→ 160@64², 320@32², 640@16²&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 layers/heads/bev_depth_head.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ self.trunk / forward&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1350" y="150" width="290" height="130" as="geometry"/></mxCell><mxCell id="p2_33" value='&lt;b&gt;BEV neck: SECONDFPN&lt;/b&gt; 🔥 (mmdet3d)&lt;br&gt;[80,160,320,640] ↑[1,2,4,8] → 64ch×4&lt;br&gt;→ (B, 256, 128, 128)&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 layers/heads/bev_depth_head.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ self.neck&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1350" y="310" width="290" height="120" as="geometry"/></mxCell><mxCell id="p2_34" value='&lt;b&gt;CenterHead&lt;/b&gt; 🔥 (mmdet3d CenterHead 継承)&lt;br&gt;shared conv + SeparateHead × 6 tasks&lt;br&gt;heatmap / reg(2) / height(1) / dim(3) / rot(2) / vel(2)&lt;br&gt;heatmap bias init −2.19&lt;br&gt;&lt;br&gt;tasks: car | truck, const_veh | bus, trailer |&lt;br&gt;barrier | motorcycle, bicycle | ped, cone&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 layers/heads/bev_depth_head.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ BEVDepthHead.__init__ / forward&lt;/font&gt;&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 exps/nuscenes/base_exp.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ head_conf / TASKS / common_heads&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1350" y="460" width="290" height="240" as="geometry"/></mxCell><mxCell id="p2_35" value="80×128×128" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2_25" target="p2_32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p2_32" target="p2_33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_37" value="256×128×128" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p2_33" target="p2_34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_38" value='&lt;b&gt;学習 training_step&lt;/b&gt; (lift 版をオーバーライド)&lt;br&gt;detection_loss = GaussianFocal(heatmap) + 0.25·L1(bbox)&lt;br&gt;&lt;b&gt;loss = detection_loss のみ&lt;/b&gt;&lt;br&gt;depth_loss_monitor = 3·BCE(prior, LiDAR GT) を no_grad で記録&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 exps/nuscenes/mv/bev_depth_dinov3_metric3d.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ BEVDepthLightningModel.training_step&lt;/font&gt;&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 layers/heads/bev_depth_head.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ get_targets / loss&lt;/font&gt;&lt;br&gt;Optimizer: AdamW(requires_grad のみ) + MultiStepLR (--lr 指定時)&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 exps/nuscenes/mv/bev_depth_dinov3.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ configure_optimizers&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="270" y="760" width="560" height="230" as="geometry"/></mxCell><mxCell id="p2_39" value='&lt;b&gt;推論 eval_step / predict_step&lt;/b&gt;&lt;br&gt;model(imgs, mats) → head.get_bboxes&lt;br&gt;CenterPointBBoxCoder decode → circle NMS&lt;br&gt;→ 3D boxes / scores / labels&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 exps/nuscenes/base_exp.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ eval_step / test_step / predict_step&lt;/font&gt;&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 layers/heads/bev_depth_head.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ get_bboxes / size_aware_circle_nms&lt;/font&gt;&lt;br&gt;評価: nuScenes mAP / NDS、-p 時は結果 JSON 出力&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 evaluators/det_evaluators.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ DetNuscEvaluator&lt;/font&gt;&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 exps/base_cli.py&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ run_cli: fit / -e test / -p predict&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="860" y="760" width="440" height="230" as="geometry"/></mxCell><mxCell id="p2_40" value="preds (train)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="p2_34" target="p2_38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_41" value="preds (eval)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="p2_34" target="p2_39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_42" value="GT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p2_4" target="p2_38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_43" value="prior (monitor)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="p2_12" target="p2_38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_44" value="&lt;b&gt;凡例&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1360" y="760" width="300" height="190" as="geometry"/></mxCell><mxCell id="p2_45" value="❄ Frozen（事前学習・勾配なし）" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1370" y="788" width="135" height="30" as="geometry"/></mxCell><mxCell id="p2_46" value="🔥 Trainable" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1515" y="788" width="135" height="30" as="geometry"/></mxCell><mxCell id="p2_47" value="パラメータなし演算" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1370" y="826" width="135" height="30" as="geometry"/></mxCell><mxCell id="p2_48" value="データ / GT" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#F5F5F5;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1515" y="826" width="135" height="30" as="geometry"/></mxCell><mxCell id="p2_49" value="学習（Loss）" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1370" y="864" width="135" height="30" as="geometry"/></mxCell><mxCell id="p2_50" value="推論 / 評価" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1515" y="864" width="135" height="30" as="geometry"/></mxCell><mxCell id="p2_51" value='&lt;font color="#1F4E9E"&gt;📄 青字&lt;/font&gt; = 実装ファイル（↳ クラス/メソッド）&lt;br&gt;パスは bevdepth/ 以下のリポジトリ相対パス' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1370" y="900" width="285" height="45" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="ファイル・クラス対応"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p3_1" value='&lt;b style="font-size:16px"&gt;クラス継承と呼び出し関係（どのモジュールがどのファイルか）&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1640" height="40" as="geometry"/></mxCell><mxCell id="p3_2" value="&lt;b&gt;LightningModule 系（exps/）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="400" height="20" as="geometry"/></mxCell><mxCell id="p3_3" value='&lt;b&gt;run_cli()&lt;/b&gt;&lt;br&gt;argparse → model 生成 → pl.Trainer&lt;br&gt;fit / -e: test / -p: predict&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 bevdepth/exps/base_cli.py&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="360" height="110" as="geometry"/></mxCell><mxCell id="p3_4" value='&lt;b&gt;BEVDepthLightningModel&lt;/b&gt;（エントリ）&lt;br&gt;backbone を DINOv3Metric3DLSSFPN に差し替え&lt;br&gt;lift 用 training_step / CLI 引数&lt;br&gt;--depth_prior_mode / _type / --depth_scale ...&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 bevdepth/exps/nuscenes/mv/bev_depth_dinov3_metric3d.py&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFFFFF;strokeColor=#333333;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="20" y="240" width="360" height="140" as="geometry"/></mxCell><mxCell id="p3_5" value='&lt;b&gt;BEVDepthLightningModel&lt;/b&gt;&lt;br&gt;to_rgb=False / AdamW + MultiStepLR (--lr)&lt;br&gt;loss 成分ログ&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 bevdepth/exps/nuscenes/mv/bev_depth_dinov3.py&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="420" width="360" height="120" as="geometry"/></mxCell><mxCell id="p3_6" value='&lt;b&gt;BEVDepthLightningModel&lt;/b&gt; (LightningModule)&lt;br&gt;backbone_conf / head_conf / aug conf&lt;br&gt;training_step / get_depth_loss / eval_step&lt;br&gt;dataloader (NuscDetDataset)&lt;br&gt;evaluator (DetNuscEvaluator)&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 bevdepth/exps/nuscenes/base_exp.py&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="580" width="360" height="190" as="geometry"/></mxCell><mxCell id="p3_7" value="run_cli(BEVDepthLightningModel)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="p3_4" target="p3_3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_8" value="継承" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=0;dashed=0;" edge="1" parent="1" source="p3_4" target="p3_5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_9" value="継承" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=0;dashed=0;" edge="1" parent="1" source="p3_5" target="p3_6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_10" value="&lt;b&gt;nn.Module 系（models/, layers/）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="60" width="400" height="20" as="geometry"/></mxCell><mxCell id="p3_11" value='&lt;b&gt;BaseBEVDepth&lt;/b&gt;（self.model）&lt;br&gt;forward: backbone → head&lt;br&gt;get_targets / loss / get_bboxes&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 bevdepth/models/base_bev_depth.py&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="580" width="330" height="110" as="geometry"/></mxCell><mxCell id="p3_12" value="self.model =" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p3_6" target="p3_11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_13" value='&lt;b&gt;BaseLSSFPN&lt;/b&gt;&lt;br&gt;frustum / get_geometry / Lift / voxel pooling&lt;br&gt;DepthNet, ASPP, SELayer, Mlp も同ファイル&lt;br&gt;（ResNet50 + SECONDFPN は子クラスで削除）&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 bevdepth/layers/backbones/base_lss_fpn.py&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFFFFF;strokeColor=#333333;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="900" y="580" width="340" height="150" as="geometry"/></mxCell><mxCell id="p3_14" value='&lt;b&gt;DINOv3LSSFPN&lt;/b&gt;&lt;br&gt;img_backbone/img_neck を削除 → DINOv3 + Adapter&lt;br&gt;get_cam_feats を上書き&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 bevdepth/layers/backbones/dinov3_lss_fpn.py&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFFFFF;strokeColor=#333333;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="900" y="400" width="340" height="130" as="geometry"/></mxCell><mxCell id="p3_15" value='&lt;b&gt;DINOv3Metric3DLSSFPN&lt;/b&gt;（実際の model.backbone）&lt;br&gt;Metric3Dv2 追加 / _run_metric3d&lt;br&gt;_depth_prior / _forward_depth_net 上書き&lt;br&gt;concat: reduce_conv 差し替え / lift: depth_net 削除&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 bevdepth/layers/backbones/dinov3_metric3d_lss_fpn.py&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFFFFF;strokeColor=#333333;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="900" y="200" width="340" height="150" as="geometry"/></mxCell><mxCell id="p3_16" value="継承" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=0;dashed=0;" edge="1" parent="1" source="p3_15" target="p3_14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_17" value="継承" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=0;dashed=0;" edge="1" parent="1" source="p3_14" target="p3_13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_18" value=".backbone（初期値）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="p3_11" target="p3_13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_19" value=".backbone を差し替え" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#D79B00;strokeWidth=2;" edge="1" parent="1" source="p3_4" target="p3_15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_20" value='&lt;b&gt;BEVDepthHead&lt;/b&gt;（mmdet3d CenterHead 継承）&lt;br&gt;trunk ResNet-18 + neck SECONDFPN&lt;br&gt;get_targets / loss / get_bboxes / circle NMS&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 bevdepth/layers/heads/bev_depth_head.py&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFFFFF;strokeColor=#333333;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="470" y="820" width="330" height="140" as="geometry"/></mxCell><mxCell id="p3_21" value=".head" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p3_11" target="p3_20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_22" value='&lt;b&gt;Voxel pooling CUDA ops&lt;/b&gt;&lt;br&gt;voxel_pooling_train / voxel_pooling_inference&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 bevdepth/ops/voxel_pooling_train/&lt;/font&gt;&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 bevdepth/ops/voxel_pooling_inference/&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFFFFF;strokeColor=#333333;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="900" y="780" width="340" height="110" as="geometry"/></mxCell><mxCell id="p3_23" value="呼び出し" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p3_13" target="p3_22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_24" value='&lt;b&gt;外部依存（事前学習重み）&lt;/b&gt;&lt;br&gt;・DINOv3: timm.create_model(&lt;br&gt;&amp;nbsp;&amp;nbsp;"vit_base_patch16_dinov3.lvd1689m", pretrained=True)&lt;br&gt;&amp;nbsp;&amp;nbsp;→ HuggingFace Hub から取得&lt;br&gt;・Metric3Dv2: torch.hub.load(&lt;br&gt;&amp;nbsp;&amp;nbsp;METRIC3D_REPO_DIR or "yvanyin/metric3d",&lt;br&gt;&amp;nbsp;&amp;nbsp;"metric3d_vit_small", pretrain=True)&lt;br&gt;・BEV trunk / neck / CenterHead: mmdet / mmdet3d registry' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFFFFF;strokeColor=#333333;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1320" y="200" width="340" height="210" as="geometry"/></mxCell><mxCell id="p3_25" value="Metric3Dv2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="p3_15" target="p3_24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_26" value="DINOv3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.8;" edge="1" parent="1" source="p3_14" target="p3_24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_27" value='&lt;b&gt;データ / 評価&lt;/b&gt;&lt;br&gt;NuscDetDataset, collate_fn&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 bevdepth/datasets/nusc_det_dataset.py&lt;/font&gt;&lt;br&gt;DetNuscEvaluator&lt;br&gt;&lt;font color="#1F4E9E" style="font-size:10px"&gt;📄 bevdepth/evaluators/det_evaluators.py&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;arcSize=6;fillColor=#FFFFFF;strokeColor=#333333;fillColor=#F5F5F5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="470" y="240" width="330" height="150" as="geometry"/></mxCell><mxCell id="p3_28" value="dataloader / evaluator" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.3;" edge="1" parent